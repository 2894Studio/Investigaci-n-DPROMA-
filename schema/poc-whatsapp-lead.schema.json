{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dproma.local/schema/poc-whatsapp-lead.schema.json",
  "title": "Lead de WhatsApp — PoC primer contacto DPROMA",
  "description": "Parámetros que n8n envía a la RPC whatsapp_registrar_lead (propuesta) del panel DPROMA (Supabase). Borrador v0.3 (02/11/2026). Los campos marcados como 'existe' ya están en contactos_comerciales; los 'propuesto' son columnas nuevas a validar con Félix (plan B: se resumen en observaciones_texto).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nombre",
    "telefono",
    "origen",
    "canal",
    "wa_id",
    "estado_bot",
    "eventos"
  ],
  "properties": {
    "nombre": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160,
      "description": "existe · contactos_comerciales.nombre (persona o razón social)"
    },
    "telefono": {
      "type": "string",
      "pattern": "^\\+[0-9]{10,15}$",
      "description": "existe · contactos_comerciales.telefono (la BD calcula telefono_norm)"
    },
    "correo": {
      "type": [
        "string",
        "null"
      ],
      "format": "email",
      "description": "existe · contactos_comerciales.correo (el bot no lo pide; null)"
    },
    "vehiculo": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120,
      "description": "existe · contactos_comerciales.vehiculo (marca / modelo)"
    },
    "domicilio": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300,
      "description": "existe · contactos_comerciales.domicilio (texto libre con CP)"
    },
    "codigo_postal": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{5}$",
      "description": "Auxiliar: n8n lo extrae del domicilio para resolver estado_id"
    },
    "estado_id": {
      "type": [
        "integer",
        "string",
        "null"
      ],
      "description": "existe · contactos_comerciales.estado_id (catálogo de estados del panel)"
    },
    "origen": {
      "type": "string",
      "enum": [
        "directa",
        "oem"
      ],
      "description": "existe · contactos_comerciales.origen: 'oem' si llegó por el enlace de una agencia"
    },
    "agencia": {
      "type": [
        "string",
        "null"
      ],
      "description": "propuesto · nombre de la agencia (ej. 'Changan del Valle')"
    },
    "canal": {
      "type": "string",
      "enum": [
        "whatsapp"
      ],
      "description": "propuesto · distingue leads del bot de la captura manual"
    },
    "tipo_inmueble": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Casa particular",
        "Residencial",
        "Empresa / flotilla",
        null
      ],
      "description": "propuesto · mismos valores que cotizaciones.tipo_inmueble (+ empresa)"
    },
    "metros_aprox": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "hasta_10",
        "11_20",
        "21_30",
        "mas_30",
        "no_se",
        null
      ],
      "description": "propuesto · distancia tablero → lugar de carga (conceptos 1 y 3 del cotizador)"
    },
    "medidor_independiente": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "si",
        "no",
        "no_se",
        null
      ],
      "description": "propuesto · conceptos 2 (trámite CFE) y 5 (mufa) del cotizador"
    },
    "observaciones_texto": {
      "type": [
        "string",
        "null"
      ],
      "description": "existe · resumen legible generado por n8n (plan B si no hay columnas nuevas)"
    },
    "wa_id": {
      "type": "string",
      "pattern": "^[0-9]{10,15}$",
      "description": "propuesto · id de WhatsApp (bitácora del bot)"
    },
    "estado_bot": {
      "type": "string",
      "enum": [
        "COMPLETO",
        "INCOMPLETO",
        "HUMANO"
      ],
      "description": "Cómo terminó la conversación"
    },
    "motivo_humano": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "pidio_asesor",
        "flotilla",
        "no_reconocido",
        "sin_respuesta",
        null
      ]
    },
    "evidencias": {
      "type": "array",
      "description": "Se suben a Drive y se registran en comercial_evidencias DESPUÉS de crear la ficha",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tipo",
          "wa_media_id",
          "mime_type"
        ],
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "tablero",
              "sitio_recorrido",
              "medidor",
              "otro"
            ]
          },
          "wa_media_id": {
            "type": "string"
          },
          "mime_type": {
            "type": "string"
          },
          "drive_file_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "eventos": {
      "type": "array",
      "description": "Bitácora para KPIs (tabla whatsapp_eventos propuesta o n8n)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tipo",
          "ocurrido_en"
        ],
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "primer_mensaje",
              "bot_respuesta",
              "paso_respondido",
              "datos_completos",
              "derivado_humano",
              "lead_creado_crm",
              "lead_actualizado_crm",
              "foto_subida",
              "aviso_bernardo",
              "contacto_humano",
              "error_crm",
              "error_auth",
              "error_media",
              "error_aviso",
              "error_envio",
              "no_reconocido"
            ]
          },
          "ocurrido_en": {
            "type": "string",
            "format": "date-time"
          },
          "detalle": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
